{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://labview-community-ci-cd.github.io/labview-release-control-plane/contracts/program-report.schema.json",
  "title": "Release Program Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "status",
    "reason_code",
    "mode",
    "dry_run",
    "phase_results",
    "enrollment",
    "policy_summary"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pass",
        "fail",
        "warn"
      ]
    },
    "reason_code": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "dry_run": {
      "type": "boolean"
    },
    "phase_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "phase",
          "status",
          "reason_code"
        ],
        "properties": {
          "phase": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "warn",
              "skipped"
            ]
          },
          "reason_code": {
            "type": "string"
          }
        }
      }
    },
    "enrollment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_id",
        "release_workflow"
      ],
      "properties": {
        "repo_id": {
          "type": "string"
        },
        "release_workflow": {
          "type": "string"
        }
      }
    },
    "policy_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "autonomy"
      ],
      "properties": {
        "schema_version": {
          "type": "string"
        },
        "autonomy": {
          "type": "string"
        }
      }
    },
    "reason_code_taxonomy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
